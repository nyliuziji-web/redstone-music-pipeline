{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Phrase decisions",
  "type": "object",
  "required": [
    "schemaVersion",
    "profileId",
    "decisions"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "profileId": {
      "type": "string",
      "minLength": 1
    },
    "decisions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "role",
          "slot",
          "noteIds"
        ],
        "properties": {
          "role": {
            "type": "string",
            "minLength": 1
          },
          "slot": {
            "type": "string",
            "minLength": 1
          },
          "noteIds": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "transpose": {
            "type": "integer"
          }
        }
      }
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
