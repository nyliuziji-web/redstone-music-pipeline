{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Music-clock effects",
  "type": "object",
  "required": [
    "schemaVersion",
    "clock",
    "namespace",
    "lengthGT",
    "effects"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "clock": {
      "const": "musicGT"
    },
    "namespace": {
      "type": "string",
      "pattern": "^[a-z0-9_.-]+$"
    },
    "lengthGT": {
      "type": "integer",
      "minimum": 1,
      "maximum": 144000
    },
    "sampleKey": {
      "type": "integer"
    },
    "effects": {
      "type": "array",
      "maxItems": 20000,
      "items": {
        "type": "object",
        "required": [
          "id",
          "kind",
          "beginGT",
          "endGT",
          "position",
          "color"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "enum": [
              "node",
              "ring",
              "helix",
              "bezier"
            ]
          },
          "beginGT": {
            "type": "integer",
            "minimum": 0
          },
          "endGT": {
            "type": "integer",
            "minimum": 1
          },
          "position": {
            "type": "array",
            "minItems": 3,
            "maxItems": 3,
            "items": {
              "type": "number"
            }
          },
          "color": {
            "type": "string",
            "pattern": "^[0-9A-Fa-f]{6}$"
          }
        }
      }
    },
    "captions": {
      "type": "array"
    }
  }
}
