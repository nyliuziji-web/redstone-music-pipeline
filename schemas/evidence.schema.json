{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "File-bound evidence",
  "type": "object",
  "required": [
    "schemaVersion",
    "method",
    "inputs",
    "result",
    "limitations"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "method": {
      "type": "string",
      "minLength": 1
    },
    "inputs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "path",
          "sha256"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      }
    },
    "result": {
      "type": "object"
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "runtimeVerified": {
      "type": "boolean"
    },
    "clientVerified": {
      "type": "boolean"
    }
  }
}
