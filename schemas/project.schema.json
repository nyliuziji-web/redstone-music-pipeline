{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Production project",
  "type": "object",
  "required": [
    "schemaVersion",
    "slug",
    "title",
    "inputs"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "inputs": {
      "type": "object",
      "additionalProperties": {
        "type": [
          "string",
          "null"
        ]
      }
    },
    "runtime": {
      "type": "object"
    },
    "policy": {
      "type": "object"
    }
  }
}
