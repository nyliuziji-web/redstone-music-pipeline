{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Declarative voxel module",
  "type": "object",
  "required": [
    "schemaVersion"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "blocks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "pos",
          "block"
        ],
        "properties": {
          "pos": {
            "type": "array",
            "minItems": 3,
            "maxItems": 3,
            "items": {
              "type": "integer"
            }
          },
          "block": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "operations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "op"
        ],
        "properties": {
          "op": {
            "enum": [
              "set",
              "fill",
              "frame",
              "stairs"
            ]
          }
        }
      }
    }
  },
  "anyOf": [
    {
      "required": [
        "blocks"
      ]
    },
    {
      "required": [
        "operations"
      ]
    }
  ]
}
