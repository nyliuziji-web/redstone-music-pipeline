{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["schemaVersion"],
  "additionalProperties": false,
  "$defs": {"style": {"enum": ["copper", "tide", "moon"]}},
  "properties": {
    "schemaVersion": {"const": 1},
    "sourceMidiSha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "style": {"$ref": "#/$defs/style"},
    "sections": {
      "type": "array", "minItems": 1, "maxItems": 256,
      "items": {
        "type": "object",
        "required": ["beginGT", "endGT"],
        "additionalProperties": false,
        "properties": {
          "beginGT": {"type": "integer", "minimum": 0},
          "endGT": {"type": "integer", "minimum": 1},
          "label": {"type": "string", "minLength": 1, "maxLength": 48},
          "style": {"$ref": "#/$defs/style"},
          "focus": {"type": "string", "minLength": 1},
          "spread": {"type": "integer", "minimum": 0, "maximum": 3},
          "terrace": {"type": "integer", "minimum": -2, "maximum": 2},
          "turn": {"type": "integer", "minimum": -1, "maximum": 1},
          "anchors": {
            "type": "object",
            "additionalProperties": {
              "type": "array", "minItems": 2, "maxItems": 2,
              "prefixItems": [
                {"type": "integer", "minimum": 7, "maximum": 72},
                {"type": "integer", "minimum": 92, "maximum": 125}
              ]
            }
          }
        }
      }
    }
  }
}
